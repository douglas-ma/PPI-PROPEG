# .env.example
# Copie este arquivo para .env e preencha os valores.
# NUNCA commit o .env real no Git.

# Django
SECRET_KEY=gere-uma-chave-segura-aqui
DEBUG=False
ALLOWED_HOSTS=.onrender.com,meudominio.com.br
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://meudominio.com.br
DJANGO_SETTINGS_MODULE=plataforma_projetos.settings_prod

# Banco de dados (gerado automaticamente pelo Render)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# E-mail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-gmail
DEFAULT_FROM_EMAIL=seu@gmail.com

# Armazenamento de mídia (opcional — Cloudinary)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
