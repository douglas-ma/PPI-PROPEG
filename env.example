# .env.example
# Copie este arquivo para .env e preencha os valores.
# NUNCA commit o .env real no Git.

# Django
SECRET_KEY=gere-uma-chave-segura-aqui
DEBUG=False
ALLOWED_HOSTS=.onrender.com,meudominio.com.br
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://meudominio.com.br
DJANGO_SETTINGS_MODULE=plataforma_projetos.settings_prod

# Banco de dados (gerado automaticamente pelo Render)
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# E-mail transacional (Brevo)
BREVO_API_KEY=chave-da-api-brevo
DEFAULT_FROM_EMAIL=email-verificado-no-brevo@example.com

# Armazenamento persistente de mídia (Cloudinary)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Administrador inicial
ADMIN_CPF=cpf-valido-sem-pontuacao
ADMIN_EMAIL=administrador@example.com
ADMIN_PASSWORD=defina-uma-senha-forte
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=PROPEG
